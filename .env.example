# Copy to .env. Used by compose/codelikehome.yaml.
CLH_IMAGE=ghcr.io/fiddler110/codelikehome-forwarder   # the account that publishes the image
CLH_TAG=0.1.0                                     # pin a release; bump it on purpose
CLH_UID=1000                                      # the editor user's uid (id -u)
CLH_SOCKET_DIR=/home/YOURUSER/.local/run/code-server
CLH_ALLOW=warpgate                                # container/host name of your bastion
# CLH_CONTAINER=vscode
# CLH_NETWORK=vscode_net
# CLH_PULL_POLICY=missing                         # "never" when you build the image locally
