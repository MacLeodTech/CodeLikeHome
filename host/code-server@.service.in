# Installed by CodeLikeHome (version @VERSION@). Edit via host/install.sh, not by hand.
# One editor per signed-in user, started on demand by codelikehome-gate (`systemctl start code-server@alice`).
[Unit]
Description=code-server (VS Code in the browser) for %i
After=local-fs.target

[Service]
Type=simple
# run-editor starts as root only to drop to the user: their uid and gid, the profile's groups (@PROFILE@) and umask.
# NoNewPrivileges stays off on purpose, sudo needs its setuid bit.
ExecStart=/usr/local/lib/codelikehome/run-editor %i
@ENVFILE@
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
Restart=on-failure
RestartSec=5
# no [Install]: editors start when someone signs in
