# Installed by CodeLikeHome (version @VERSION@). Edit via host/install.sh, not by hand.
[Unit]
Description=CodeLikeHome sign-in gate (PAM login in front of per-user editors)
After=local-fs.target

[Service]
Type=simple
# Root, because PAM must read other users' password hashes and the gate must reach every user's mode-600 editor socket.
EnvironmentFile=/etc/codelikehome/gate.env
ExecStart=/usr/bin/python3 -I /usr/local/lib/codelikehome/gate.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@RUNDIR@ /run/codelikehome
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
